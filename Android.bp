android_library {
    name: "ParanoidGlyph-core",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],

    static_libs: [
        "IGlyphService-java",
        "SettingsLib",
        "SettingsLibSliderPreference",
        "androidx.core_core",
        "androidx.preference_preference",
        "com.google.android.material_material",
    ],

    platform_apis: true,
}

java_defaults {
    name: "ParanoidGlyph-defaults",

    static_libs: ["ParanoidGlyph-core"],

    platform_apis: true,
    certificate: "platform",
    privileged: true,
    privapp_allowlist: "permissions/privapp_whitelist_co.aospa.glyph.xml",
    system_ext_specific: true,

    required: [
        "GlyphAdapter",
        "whitelist_co.aospa.glyph",
    ],
}

android_app {
    name: "ParanoidGlyphPhone1",

    defaults: ["ParanoidGlyph-defaults"],

    asset_dirs: ["phone1/assets"],
    resource_dirs: ["phone1/res"],
}

android_app {
    name: "ParanoidGlyphPhone2",

    defaults: ["ParanoidGlyph-defaults"],

    asset_dirs: ["phone2/assets"],
    resource_dirs: ["phone2/res"],
}

prebuilt_etc {
    name: "whitelist_co.aospa.glyph",
    system_ext_specific: true,
    sub_dir: "sysconfig",
    src: "permissions/whitelist_co.aospa.glyph.xml",
    filename_from_src: true,
}
